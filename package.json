{
  "name": "@ingestron/docs",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/zip-examples.ts",
    "build": "next build",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test": "vitest run --dir test",
    "validate": "pnpm format:check && pnpm secrets:check && pnpm licences:check && node --test scripts/*.test.mjs && pnpm typecheck && pnpm test && pnpm build && pnpm check:links",
    "check:links": "tsx scripts/check-links.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:check": "node scripts/scan-secrets.mjs",
    "licences:check": "node scripts/check-licences.mjs",
    "dco:check": "node scripts/check-dco.mjs",
    "sync:vscode": "node scripts/sync-vscode-commands.mjs"
  },
  "dependencies": {
    "@ingestron/authoring": "^1.1.0",
    "@ingestron/cli": "^1.1.0",
    "@ingestron/definitions": "^1.1.0",
    "@ingestron/pack-adf": "^1.1.0",
    "@ingestron/pack-databricks": "^1.0.0",
    "fflate": "0.8.2",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.8",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.28",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.135.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
